  "paths": {
    "/audit_events": {
      "get": {
        "summary": "List audit events",
        "tags": [
          "Audit events"
        ],
        "operationId": "listAuditEvents",
        "description": "Append-only audit trail, newest first. Each event records the acting API key, request id, IP address\nand user agent, plus event-specific metadata.\n\n| `action` | Recorded when |\n|---|---|\n| `tradeline.created` | An admin creates a tradeline |\n| `deposit.created` | A deposit is committed (in the same transaction) |\n| `deposit.rejected` | A deposit fails validation or the balance check |\n| `deposit.idempotent_replay` | A retry is answered with an existing deposit |\n| `authorization.denied` | A key attempts an action its role does not allow |\n\nPaginated — see the pagination headers. **Role:** `admin`.\n",
        "parameters": [
          {
            "name": "event",
            "in": "query",
            "required": false,
            "description": "Filter by action.",
            "schema": {
              "type": "string",
              "enum": [
                "tradeline.created",
                "deposit.created",
                "deposit.rejected",
                "deposit.idempotent_replay",
                "authorization.denied"
              ]
            }
          },
          {
            "name": "auditable_type",
            "in": "query",
            "required": false,
            "description": "Filter by record type.",
            "schema": {
              "type": "string",
              "enum": [
                "Tradeline",
                "Deposit"
              ]
            }
          },
          {
            "name": "auditable_id",
            "in": "query",
            "required": false,
            "description": "Filter by record id.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "api_key_id",
            "in": "query",
            "required": false,
            "description": "Filter by acting API key.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "request_id",
            "in": "query",
            "required": false,
            "description": "Filter by the `X-Request-Id` of the request that caused the event.",
            "schema": {
              "type": "string"
            }
          },
          {
            "$ref": "#/components/parameters/page"
          },
          {
            "$ref": "#/components/parameters/limit"
          }
        ],
        "responses": {
          "200": {
            "description": "A page of audit events",
            "headers": {
              "link": {
                "schema": {
                  "type": "string"
                },
                "description": "RFC 8288 links: `rel=\"first\"`, `\"prev\"`, `\"next\"`, `\"last\"`."
              },
              "current-page": {
                "schema": {
                  "type": "string"
                },
                "description": "Current page number."
              },
              "page-items": {
                "schema": {
                  "type": "string"
                },
                "description": "Items per page (the effective `limit`)."
              },
              "total-pages": {
                "schema": {
                  "type": "string"
                },
                "description": "Number of pages."
              },
              "total-count": {
                "schema": {
                  "type": "string"
                },
                "description": "Total number of items."
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/AuditEvent"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid API key",
            "headers": {
              "www-authenticate": {
                "schema": {
                  "type": "string"
                },
                "description": "`Bearer realm=\"deposits\"`"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UnauthorizedError"
                }
              }
            }
          },
          "403": {
            "description": "The key's role does not allow this action",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ForbiddenError"
                }
              }
            }
          }
        }
      }
    },
