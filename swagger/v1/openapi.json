      "post": {
        "summary": "Create a deposit",
        "tags": [
          "Deposits"
        ],
        "operationId": "createDeposit",
        "description": "Schedules a deposit against the tradeline and returns it with the tradeline's new outstanding balance.\n\n- `amount` must be greater than 0, have at most 2 decimal places, and be **no more than the current\n  outstanding balance** (depositing exactly the remaining balance is allowed). The check is atomic,\n  so concurrent requests can never overdraw the tradeline.\n- `deposit_date` must be `YYYY-MM-DD`.\n- Send an `Idempotency-Key` to make retries safe.\n\nThe body may be flat or wrapped in `{\"deposit\": {…}}`. Deposits cannot be changed or deleted afterwards.\nSuccessful and rejected attempts are recorded in the audit log. **Role:** `operator` or `admin`.\n",
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "maxLength": 255
            },
            "description": "Unique key per intended deposit, e.g. a UUID such as `6f1c2c9e-3f0a-4b8e-9a41-1d2f1b7c8e10`. A retry with the same key and body returns the original deposit instead of creating a new one. Scoped per tradeline. Use a new key for each new deposit."
          }
        ],
        "responses": {
          "201": {
            "description": "Deposit created",
            "headers": {
              "location": {
                "schema": {
                  "type": "string"
                },
                "description": "URL of the new deposit."
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DepositWithBalance"
                }
              }
            }
          },
          "200": {
            "description": "Idempotent replay: this Idempotency-Key was already used with the same body",
            "headers": {
              "idempotent-replayed": {
                "schema": {
                  "type": "string",
                  "enum": [
                    "true"
                  ]
                },
                "description": "Present when the original deposit is being returned."
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DepositWithBalance"
                }
              }
            }
          },
          "400": {
            "description": "Missing or malformed body",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BadRequestError"
                }
              }
            }
          },
          "404": {
            "description": "Tradeline not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NotFoundError"
                }
              }
            }
          },
          "422": {
            "description": "Rejected: invalid input, insufficient balance, or a reused Idempotency-Key",
            "content": {
              "application/json": {
                "examples": {
                  "insufficient_balance": {
                    "value": {
                      "error": {
                        "code": "insufficient_balance",
                        "message": "Deposit exceeds the outstanding balance",
                        "details": {
                          "amount": [
                            "exceeds the outstanding balance of 750.00"
                          ]
                        }
                      }
                    },
                    "summary": "Deposit exceeds the outstanding balance"
                  },
                  "validation_failed": {
                    "value": {
                      "error": {
                        "code": "validation_failed",
                        "message": "Deposit is invalid",
                        "details": {
                          "amount": [
                            "must be greater than 0",
                            "must have at most 2 decimal places"
                          ],
                          "deposit_date": [
                            "must be a valid date in YYYY-MM-DD format"
                          ]
                        }
                      }
                    },
                    "summary": "Invalid amount and date"
                  },
                  "idempotency_key_reused": {
                    "value": {
                      "error": {
                        "code": "idempotency_key_reused",
                        "message": "Idempotency-Key was already used for a different deposit",
                        "details": {
                          "idempotency_key": [
                            "was already used with different parameters"
                          ]
                        }
                      }
                    },
                    "summary": "Idempotency-Key reused with a different body"
                  }
                },
                "schema": {
                  "$ref": "#/components/schemas/DepositError"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid API key",
            "headers": {
              "www-authenticate": {
                "schema": {
                  "type": "string"
                },
                "description": "`Bearer realm=\"deposits\"`"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UnauthorizedError"
                }
              }
            }
          },
          "403": {
            "description": "The key's role does not allow this action",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ForbiddenError"
                }
              }
            }
          }
        },
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DepositInput"
              },
              "examples": {
                "deposit": {
                  "summary": "Schedule a deposit",
                  "value": {
                    "amount": "250.00",
                    "deposit_date": "2026-11-15"
                  }
                },
                "too_large": {
                  "summary": "Exceeds the balance (422)",
                  "value": {
                    "amount": "5000.00",
                    "deposit_date": "2026-11-15"
                  }
                },
                "invalid": {
                  "summary": "Invalid input (422)",
                  "value": {
                    "amount": "-1.005",
                    "deposit_date": "2026-02-30"
                  }
                }
              }
            }
          },
          "required": true
        }
      }
    },
