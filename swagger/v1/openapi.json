            "type": "string",
            "pattern": "^-?\\d+\\.\\d{2}$",
            "example": "750.00",
            "description": "The tradeline's outstanding balance now.",
            "nullable": true
          }
        }
      },
      "DepositInput": {
        "type": "object",
        "required": [
          "amount",
          "deposit_date"
        ],
        "properties": {
          "amount": {
            "type": "string",
            "example": "250.00",
            "description": "Greater than 0, at most 2 decimal places, and no more than the outstanding balance. A JSON number is also accepted."
          },
          "deposit_date": {
            "type": "string",
            "format": "date",
            "example": "2026-11-15",
            "description": "Strict ISO 8601 `YYYY-MM-DD`. Usually a future date; past dates are allowed."
          }
        }
      },
      "AuditEvent": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "action",
          "auditable_type",
          "auditable_id",
          "metadata",
          "request_id",
          "ip_address",
          "user_agent",
          "created_at",
          "actor"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "example": 7
          },
          "action": {
            "type": "string",
            "enum": [
              "tradeline.created",
              "deposit.created",
              "deposit.rejected",
              "deposit.idempotent_replay",
              "authorization.denied"
            ],
            "example": "deposit.created"
          },
          "auditable_type": {
            "type": "string",
            "nullable": true,
            "enum": [
              "Tradeline",
              "Deposit",
              null
            ],
            "example": "Deposit"
          },
          "auditable_id": {
            "type": "integer",
            "nullable": true,
            "example": 2
          },
          "metadata": {
            "type": "object",
            "additionalProperties": true,
            "description": "Event details, e.g. amounts and balances before/after, or the rejection reason.",
            "example": {
              "tradeline_id": 4,
              "amount": "100.00",
              "deposit_date": "2026-12-15",
              "outstanding_balance_before": "750.00",
              "outstanding_balance_after": "650.00"
            }
          },
          "request_id": {
            "type": "string",
            "nullable": true,
            "example": "4aa34462-e665-4db7-b1df-574967cefd63",
            "description": "Matches the `X-Request-Id` response header and the request log line."
          },
          "ip_address": {
            "type": "string",
            "nullable": true,
            "example": "203.0.113.7"
          },
          "user_agent": {
            "type": "string",
            "nullable": true,
            "example": "curl/8.7.1"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "example": "2026-10-25T02:30:35.113Z"
          },
          "actor": {
            "type": "object",
            "nullable": true,
            "additionalProperties": false,
            "description": "The API key that performed the action.",
            "required": [
              "id",
              "name",
              "role",
              "token_prefix"
            ],
            "properties": {
              "id": {
                "type": "integer",
                "example": 2
              },
              "name": {
                "type": "string",
                "example": "payments-service"
              },
              "role": {
                "type": "string",
                "enum": [
                  "viewer",
                  "operator",
                  "admin"
                ],
                "example": "operator"
              },
              "token_prefix": {
                "type": "string",
                "example": "dpx_7Hq2xLm9",
                "description": "First 12 characters of the key, for identification."
              }
            }
          }
        }
      },
