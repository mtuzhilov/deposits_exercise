            "description": "Missing or invalid API key",
            "headers": {
              "www-authenticate": {
                "schema": {
                  "type": "string"
                },
                "description": "`Bearer realm=\"deposits\"`"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UnauthorizedError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearer_auth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "API key (dpx_…)",
        "description": "API key issued with `bin/rails \"auth:create_key[name,role]\"`. Paste the token only."
      }
    },
    "parameters": {
      "page": {
        "name": "page",
        "in": "query",
        "required": false,
        "description": "Page number (1-based).",
        "schema": {
          "type": "integer",
          "minimum": 1,
          "default": 1
        }
      },
      "limit": {
        "name": "limit",
        "in": "query",
        "required": false,
        "description": "Items per page.",
        "schema": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "default": 25
        }
      }
    },
    "schemas": {
      "Tradeline": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "amount",
          "deposits_total",
          "outstanding_balance",
          "created_at",
          "updated_at"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "example": 4
          },
          "name": {
            "type": "string",
            "example": "Visa Gold"
          },
          "amount": {
            "type": "string",
            "pattern": "^-?\\d+\\.\\d{2}$",
            "example": "1000.00",
            "description": "Total amount owed. `null` only for legacy records.",
            "nullable": true
          },
          "deposits_total": {
            "type": "string",
            "pattern": "^-?\\d+\\.\\d{2}$",
            "example": "350.00",
            "description": "Sum of all deposits."
          },
          "outstanding_balance": {
            "type": "string",
            "pattern": "^-?\\d+\\.\\d{2}$",
            "example": "650.00",
            "description": "`amount − deposits_total`. `null` when the tradeline has no amount.",
            "nullable": true
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "example": "2026-10-25T02:30:35.113Z"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "example": "2026-10-25T02:30:35.113Z"
          }
        }
      },
      "TradelineInput": {
        "type": "object",
        "required": [
          "name",
          "amount"
        ],
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 255,
            "example": "Visa Gold"
          },
          "amount": {
            "type": "string",
            "example": "1000.00",
            "description": "At least 0, at most 2 decimal places, at most 999999.99."
          }
        }
      },
      "Deposit": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "tradeline_id",
          "amount",
          "deposit_date",
          "created_at"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "example": 1
          },
          "tradeline_id": {
            "type": "integer",
            "example": 4
          },
          "amount": {
            "type": "string",
            "pattern": "^-?\\d+\\.\\d{2}$",
            "example": "250.00",
            "description": "Decimal amount as a string with exactly two decimals."
          },
          "deposit_date": {
            "type": "string",
            "format": "date",
            "example": "2026-11-15",
            "description": "Date the deposit is scheduled for."
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "example": "2026-10-25T02:30:35.113Z"
          }
        }
      },
      "DepositWithBalance": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "tradeline_id",
          "amount",
          "deposit_date",
          "created_at",
          "tradeline_outstanding_balance"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "example": 1
          },
          "tradeline_id": {
            "type": "integer",
            "example": 4
          },
          "amount": {
            "type": "string",
            "pattern": "^-?\\d+\\.\\d{2}$",
            "example": "250.00",
            "description": "Decimal amount as a string with exactly two decimals."
          },
          "deposit_date": {
            "type": "string",
            "format": "date",
            "example": "2026-11-15"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "example": "2026-10-25T02:30:35.113Z"
